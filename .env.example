# Secrets — copy to .env for local runs; add each as a GitHub Actions
# repository secret (Settings → Secrets and variables → Actions) for CI.

ANTHROPIC_API_KEY=

# Gmail app password for [delivery] channel = "email"
# Create one at https://myaccount.google.com/apppasswords (requires 2FA).
SMTP_PASSWORD=

# Only if [delivery] channel = "slack" or "discord": the incoming-webhook URL.
WEBHOOK_URL=
